<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Duolingo Feather Green) -->
    <style name="Theme.GoalTracker" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/duo_green</item>
        <item name="colorPrimaryVariant">@color/duo_green_dark</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/duo_blue</item>
        <item name="colorSecondaryVariant">@color/duo_blue_dark</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/duo_green_dark</item>
    </style>

    <!-- NoActionBar theme for screens with custom Duolingo headers -->
    <style name="Theme.GoalTracker.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/duo_green</item>
        <item name="colorPrimaryVariant">@color/duo_green_dark</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/duo_blue</item>
        <item name="colorSecondaryVariant">@color/duo_blue_dark</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/duo_green_dark</item>
    </style>
</resources>
