<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_duo_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ivSecurityIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="Bảo mật"
            android:src="@drawable/ic_duo_mascot" />

        <TextView
            android:id="@+id/tvSecurityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Bảo Mật Quyền Riêng Tư"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSecurityPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:text="Nhập mã PIN gồm 4 số để bảo vệ thông tin mục tiêu cá nhân của bạn."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPinCode"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_duo_input"
            android:gravity="center"
            android:inputType="numberPassword"
            android:letterSpacing="0.45"
            android:maxLength="4"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitPin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_duo_green"
            android:text="XÁC NHẬN"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDisablePin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_duo_white"
            android:text="TẮT BẢO MẬT MÃ PIN"
            android:textColor="@color/duo_red_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
