<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_duo_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Thiết Lập Mục Tiêu Mới"
            android:textColor="@color/duo_green_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Tên mục tiêu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên mục tiêu (*)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGoalTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_duo_input"
            android:hint="Ví dụ: Đạt chứng chỉ IELTS 7.5"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <!-- Mô tả chi tiết -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả chi tiết mục tiêu"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGoalDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_duo_input"
            android:gravity="top|start"
            android:hint="Lý do muốn đạt mục tiêu, kết quả mong đợi..."
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <!-- Lĩnh vực -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lĩnh vực"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spGoalCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_duo_input"
            android:paddingHorizontal="8dp" />

        <!-- Loại mục tiêu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thời hạn mục tiêu"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGoalType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbShortTerm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:buttonTint="@color/duo_green"
                android:checked="true"
                android:text="Ngắn hạn (&lt; 1 tháng)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbLongTerm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/duo_green"
                android:text="Dài hạn"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- Độ khó -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mức độ khó của mục tiêu"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spGoalDifficulty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_duo_input"
            android:paddingHorizontal="8dp" />

        <!-- Hạn chót Deadline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngày hạn chót (Deadline) (*)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPickDeadline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_duo_white"
            android:text="Chọn ngày hoàn thành"
            android:textAllCaps="false"
            android:textColor="@color/duo_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Nút Lưu 3D Duolingo -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveGoal"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/btn_duo_green"
            android:text="LƯU MỤC TIÊU"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
