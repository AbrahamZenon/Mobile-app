<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thiết Lập Mục Tiêu Mới 🎯"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="20dp" />

        <!-- Tên mục tiêu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên mục tiêu (*)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/etGoalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: Đạt chứng chỉ IELTS 7.5"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Mô tả chi tiết -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả chi tiết mục tiêu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/etGoalDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Lý do muốn đạt mục tiêu, kết quả mong đợi..."
            android:gravity="top|start"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Lĩnh vực -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lĩnh vực"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Spinner
            android:id="@+id/spGoalCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/btn_dropdown" />

        <!-- Loại mục tiêu: Ngắn hạn / Dài hạn -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thời hạn mục tiêu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <RadioGroup
            android:id="@+id/rgGoalType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbShortTerm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngắn hạn (dưới 1 tháng)"
                android:checked="true"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbLongTerm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dài hạn" />
        </RadioGroup>

        <!-- Độ khó -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mức độ khó của mục tiêu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Spinner
            android:id="@+id/spGoalDifficulty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/btn_dropdown" />

        <!-- Hạn chót Deadline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngày hạn chót (Deadline) (*)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnPickDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn ngày hoàn thành"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/primary"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Nút Lưu -->
        <Button
            android:id="@+id/btnSaveGoal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="LƯU MỤC TIÊU"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="@color/surface" />

    </LinearLayout>
</ScrollView>
