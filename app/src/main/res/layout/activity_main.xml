<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Duolingo Top Bar HUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_duo_mascot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GoalTracker"
                    android:textColor="@color/duo_green_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang quản lý 0 mục tiêu"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Navigation Icon Buttons -->
            <ImageButton
                android:id="@+id/btnStatistics"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Thống kê"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bar_chart"
                app:tint="@color/duo_blue" />

            <ImageButton
                android:id="@+id/btnGamification"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Thành tích"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_celebration"
                app:tint="@color/duo_gold" />

            <ImageButton
                android:id="@+id/btnNotificationSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cài đặt nhắc nhở"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notification"
                app:tint="@color/duo_orange" />

            <ImageButton
                android:id="@+id/btnSecuritySettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cài đặt mã PIN"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Crisp 2dp Duolingo Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/duo_border" />

        <!-- Duolingo Gamification HUD & Mascot Speech Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDashboardGamification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_duo_card"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Streak Flame Pill & Trophy Pill Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_duo_hud_streak"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Streak"
                            android:src="@drawable/ic_streak_fire" />

                        <TextView
                            android:id="@+id/tvDashboardStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="0 ngày liên tiếp"
                            android:textColor="@color/duo_orange_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_duo_hud_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Huy hiệu"
                            android:src="@drawable/ic_badge_default" />

                        <TextView
                            android:id="@+id/tvDashboardBadgeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="0 / 8 huy hiệu"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mascot Coach Speech Bubble (Daily Quote) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_duo_speech_bubble"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Mascot"
                        android:src="@drawable/ic_duo_mascot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDashboardQuote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Mỗi bước tiến nhỏ hôm nay đều đưa bạn đến gần hơn với mục tiêu lớn ngày mai."
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDashboardQuoteAuthor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="— Goalie Coach"
                            android:textColor="@color/duo_blue_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick Nav Action Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavStatistics"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="@string/nav_statistics"
                        android:textColor="@color/duo_blue_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_bar_chart"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="15dp"
                        app:iconTint="@color/duo_blue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavGamification"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="@string/nav_gamification"
                        android:textColor="@color/duo_gold_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_celebration"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="15dp"
                        app:iconTint="@color/duo_gold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavNotifications"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="@string/nav_notification_settings"
                        android:textColor="@color/duo_orange_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_notification"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="15dp"
                        app:iconTint="@color/duo_orange" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category Horizontal Filter Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Tất cả"
                    android:textStyle="bold"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/duo_border"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHealth"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sức khỏe"
                    android:textStyle="bold"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/duo_border"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWork"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Công việc"
                    android:textStyle="bold"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/duo_border"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStudy"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Học tập"
                    android:textStyle="bold"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/duo_border"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFinance"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tài chính"
                    android:textStyle="bold"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/duo_border"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHobby"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sở thích"
                    android:textStyle="bold"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/duo_border"
                    app:chipStrokeWidth="1.5dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmptyGoals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Chưa có mục tiêu nào trong danh mục này.\nBấm dấu (+) để bắt đầu hành trình mới!"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Goals RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGoals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />

    </LinearLayout>

    <!-- Duolingo Green FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddGoal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Thêm mục tiêu"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/duo_green"
        app:borderWidth="0dp"
        app:elevation="4dp"
        app:tint="@color/surface" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
