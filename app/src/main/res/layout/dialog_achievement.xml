<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:padding="16dp">

    <!-- Duolingo 3D Bordered Celebration Card -->
    <LinearLayout
        android:id="@+id/layoutDialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_duo_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header Icon (Celebration hoặc Badge Icon) -->
        <ImageView
            android:id="@+id/ivDialogHeaderIcon"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/dialog_achievement_title"
            android:src="@drawable/ic_celebration" />

        <!-- Tiêu đề Dialog -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/dialog_achievement_title"
            android:textColor="@color/duo_gold_dark"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Phụ đề / Lời chúc mừng -->
        <TextView
            android:id="@+id/tvDialogSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/dialog_achievement_congrats"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <!-- Danh sách huy hiệu mở khóa -->
        <ScrollView
            android:id="@+id/scrollBadgeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxHeight="220dp">

            <LinearLayout
                android:id="@+id/layoutBadgeItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <!-- Nút hành động chính 3D Duolingo Green -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogDismiss"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_duo_green"
            android:text="@string/btn_dialog_awesome"
            android:textColor="@color/surface"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Pure Android Canvas Confetti Burst Overlay -->
    <com.mad.goaltracker.views.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
