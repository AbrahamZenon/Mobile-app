<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardBadgeItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:id="@+id/layoutBadgeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Icon huy hiệu -->
        <ImageView
            android:id="@+id/ivBadgeIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/section_badges"
            android:src="@drawable/ic_badge_default" />

        <!-- Tên huy hiệu -->
        <TextView
            android:id="@+id/tvBadgeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Tên Huy Hiệu"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Pill trạng thái (Đã mở khóa / Chưa mở khóa) -->
        <TextView
            android:id="@+id/tvBadgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_status_pill_locked"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/badge_status_locked"
            android:textColor="@color/badge_locked_text"
            android:textSize="11sp" />

        <!-- Mô tả ngắn điều kiện -->
        <TextView
            android:id="@+id/tvBadgeDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Mô tả điều kiện huy hiệu"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Thời điểm mở khóa -->
        <TextView
            android:id="@+id/tvBadgeUnlockedAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/badge_gold"
            android:textSize="10sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
