<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/duo_border" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="10dp" />
                        <solid android:color="@color/duo_green" />
                    </shape>
                </item>
                <item
                    android:top="3dp"
                    android:bottom="8dp"
                    android:left="6dp"
                    android:right="6dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="6dp" />
                        <solid android:color="@color/duo_green_highlight" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
