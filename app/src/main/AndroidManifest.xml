<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mad.goaltracker">

    <!-- Quyền phục hồi lịch nhắc nhở sau khi thiết bị khởi động lại -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Quyền gửi thông báo trên Android 13+ (API 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Quyền lập lịch exact alarm trên Android 12+ (API 31) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".GoalTrackerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoalTracker">

        <!-- Màn hình kiểm tra mã PIN bảo mật khi khởi động ứng dụng -->
        <activity
            android:name=".activities.SecurityPinActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình chính Dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Màn hình thêm / sửa mục tiêu -->
        <activity
            android:name=".activities.AddEditGoalActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Màn hình chi tiết mục tiêu & danh sách kế hoạch tasks -->
        <activity
            android:name=".activities.GoalDetailActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Màn hình ghi chú & nhật ký hành trình -->
        <activity
            android:name=".activities.JournalActivity"
            android:exported="false"
            android:parentActivityName=".activities.GoalDetailActivity" />

        <!-- Màn hình viết nhật ký mới -->
        <activity
            android:name=".activities.AddJournalActivity"
            android:exported="false"
            android:parentActivityName=".activities.JournalActivity" />

        <!-- Màn hình thống kê tiến độ, phân bố danh mục và năng suất 7 ngày (Prompt 5) -->
        <activity
            android:name=".activities.StatisticsActivity"
            android:exported="false"
            android:label="@string/title_statistics"
            android:parentActivityName=".activities.MainActivity" />

        <!-- BroadcastReceiver nhận alarm từ AlarmManager (Nội bộ, không export) -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false" />

        <!-- BroadcastReceiver khôi phục lịch khi Boot, đổi giờ, đổi timezone hoặc cấp quyền exact alarm -->
        <receiver
            android:name=".notification.BootRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
