<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mad.goaltracker">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoalTracker">

        <!-- Màn hình kiểm tra mã PIN bảo mật khi khởi động ứng dụng -->
        <activity
            android:name=".activities.SecurityPinActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình chính Dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Màn hình thêm / sửa mục tiêu -->
        <activity
            android:name=".activities.AddEditGoalActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Màn hình chi tiết mục tiêu & danh sách kế hoạch tasks -->
        <activity
            android:name=".activities.GoalDetailActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Màn hình ghi chú & nhật ký hành trình -->
        <activity
            android:name=".activities.JournalActivity"
            android:exported="false"
            android:parentActivityName=".activities.GoalDetailActivity" />

        <!-- Màn hình viết nhật ký mới -->
        <activity
            android:name=".activities.AddJournalActivity"
            android:exported="false"
            android:parentActivityName=".activities.JournalActivity" />

    </application>

</manifest>
